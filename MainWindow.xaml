<Window x:Class="ClaudeCouncilManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ClaudeCouncilManager.ViewModels"
        Title="Claude Council Manager"
        Height="760" Width="1180"
        MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/council.ico"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Segoe UI">


    <DockPanel>
        <!-- Top bar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource TopBarBackground}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="18,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Claude Council Manager" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,28,0"/>
                <RadioButton x:Name="CouncilsTab" Content="Councils" GroupName="Nav" IsChecked="True"
                             Style="{StaticResource NavTabStyle}"/>
                <RadioButton x:Name="ExpertsTab" Content="Experts" GroupName="Nav"
                             Style="{StaticResource NavTabStyle}"/>
                <RadioButton x:Name="SettingsTab" Content="Settings" GroupName="Nav"
                             Style="{StaticResource NavTabStyle}"/>
            </StackPanel>
        </Border>

        <Grid>
            <!-- ================================ COUNCILS ================================ -->
            <Grid Visibility="{Binding IsChecked, ElementName=CouncilsTab, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <DockPanel Margin="11,12,11,0">
                    <DockPanel DockPanel.Dock="Top" Margin="7,0,7,4" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="＋  New council" VerticalAlignment="Center"
                                Command="{Binding AddCouncilCommand}" Style="{StaticResource ToolButtonStyle}"/>
                        <ToggleButton DockPanel.Dock="Right" Content="Favorites only" Margin="0,0,8,0" VerticalAlignment="Center"
                                      IsChecked="{Binding FavoriteCouncilsOnly}" Style="{StaticResource FilterToggleStyle}"/>
                        <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Text="A council is a group of experts working in its own folder. Start opens new, connected sessions; Resume reopens the last conversations; click a member to open just its session."/>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="7,0,7,6" Text="{Binding NewCouncilBlockedReason}"
                               Style="{StaticResource ErrorLine}"
                               Visibility="{Binding NewCouncilBlockedReason, Converter={StaticResource NullToVis}}"/>
                    <Border DockPanel.Dock="Top" Margin="7,2,7,8" Padding="14,10" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{DynamicResource ErrorText}" Background="{DynamicResource CardBackground}"
                            Visibility="{Binding Settings.ClaudeProblem, Converter={StaticResource NullToVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Recheck" VerticalAlignment="Center" Margin="12,0,0,0"
                                    Command="{Binding Settings.RecheckClaudeCommand}" Style="{StaticResource SmallToolButtonStyle}"/>
                            <StackPanel>
                                <TextBlock Text="Councils can be created and edited, but not started." FontWeight="SemiBold"
                                           Foreground="{DynamicResource ErrorText}"/>
                                <TextBlock Text="{Binding Settings.ClaudeProblem}" TextWrapping="Wrap" Margin="0,3,0,0"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ListBox ItemsSource="{Binding CouncilsView}" SelectedItem="{Binding SelectedCouncil}"
                             Style="{StaticResource CardListStyle}">
                        <ListBox.InputBindings>
                            <KeyBinding Key="Delete" Command="{Binding RemoveCouncilCommand}"
                                        CommandParameter="{Binding SelectedCouncil}"/>
                        </ListBox.InputBindings>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CouncilViewModel}">
                                <Grid>
                                <DockPanel Width="300" MinHeight="168">
                                    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Margin="0,0,5,0" ToolTipService.ShowOnDisabled="True"
                                                Command="{Binding DataContext.LaunchCouncilCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="▶  Start"/>
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                                                    <Setter Property="ToolTip" Value="Start new sessions for the members (new conversations)"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasRunningSessions}" Value="True">
                                                            <Setter Property="ToolTip" Value="Some sessions are running: stop them with ■ before starting new ones, or use Resume to reopen the closed members"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Grid.Column="1" Style="{StaticResource ToolButtonStyle}" Height="44" FontSize="15"
                                                FontWeight="SemiBold" Margin="5,0,0,0"
                                                ToolTip="Reopen each member's last conversation (claude --resume)"
                                                ToolTipService.ShowOnDisabled="True"
                                                Command="{Binding DataContext.ResumeCouncilCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="⟲  Resume"/>
                                        </Button>
                                        <Button Grid.Column="2" Style="{StaticResource ToolButtonStyle}" Width="44" Height="44"
                                                Padding="0" Margin="10,0,0,0"
                                                ToolTip="Stop the council's running sessions" ToolTipService.ShowOnDisabled="True"
                                                Command="{Binding DataContext.TerminateCouncilCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                        </Button>
                                    </Grid>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,94,2"/>
                                        <TextBlock Text="{Binding WorkingFolder}" ToolTip="{Binding WorkingFolder}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,94,10"
                                                   Foreground="{DynamicResource TextMuted}"/>
                                        <ItemsControl ItemsSource="{Binding Chips}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:MemberChip}">
                                                    <Button Command="{Binding DataContext.LaunchMemberCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                                        <Button.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="Open / resume the session"
                                                                          Command="{Binding PlacementTarget.Tag.LaunchMemberCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding}"/>
                                                                <MenuItem Header="Stop the session"
                                                                          Command="{Binding PlacementTarget.Tag.TerminateMemberCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding}"/>
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
                                                                <Setter Property="ToolTip" Value="Session closed: click to reopen it (resumes its last conversation, if any). Right-click for more."/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                        <Setter Property="ToolTip" Value="Session running"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="9" Height="9" Fill="{Binding Expert.ColorBrush}"
                                                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{Binding Expert.Name}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="  ★ coord." VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource Accent}"
                                                                       Visibility="{Binding IsCoordinator, Converter={StaticResource BoolToVis}}"/>
                                                            <TextBlock Text="  ● running" VerticalAlignment="Center" FontSize="11"
                                                                       Foreground="{DynamicResource OkText}"
                                                                       Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorLine}"
                                                   Visibility="{Binding Error, Converter={StaticResource NullToVis}}"/>
                                    </StackPanel>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,-6,-6,0">
                                    <Button Content="&#xE736;" Style="{StaticResource CardIconButtonStyle}" Margin="0,0,4,0"
                                            ToolTip="Logbook: the work done by the council, as recorded by its coordinator"
                                            Command="{Binding DataContext.OpenLogbookCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <ToggleButton IsChecked="{Binding IsFavorite}" Style="{StaticResource FavoriteToggleStyle}"
                                                  Margin="0,0,4,0"/>
                                    <Button Style="{StaticResource CardDeleteButtonStyle}" Margin="0" ToolTip="Delete council (Del)"
                                            Command="{Binding DataContext.RemoveCouncilCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Council editor -->
                <Border Grid.Column="1" Style="{StaticResource EditorPanelStyle}">
                    <Grid>
                        <TextBlock Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" Text="{Binding CouncilsEmptyHint}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Councils.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding SelectedCouncil}"
                                      Visibility="{Binding Converter={StaticResource NullToVis}}">
                            <StackPanel Margin="20,18">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallToolButtonStyle}" Margin="0"
                                            Command="{Binding DataContext.RemoveCouncilCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Delete"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="Council" Style="{StaticResource EditorTitle}" VerticalAlignment="Center"/>
                                </DockPanel>

                                <TextBlock Text="Name (session prefix: NAME.EXPERT)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>

                                <TextBlock Text="Working folder (where all sessions start)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding WorkingFolder, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource FieldBox}"
                                         Foreground="{DynamicResource TextSecondary}"/>
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Content="Choose…" Style="{StaticResource SmallToolButtonStyle}"
                                            Command="{Binding DataContext.ChangeWorkingFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Open" Style="{StaticResource SmallToolButtonStyle}"
                                            Command="{Binding DataContext.OpenWorkingFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                                           Text="Claude Code ties conversations to the folder they start in: this folder is what lets Resume reopen them. Each expert's CLAUDE.md and skills are loaded from its own folder."/>

                                <TextBlock Text="Members" Style="{StaticResource FieldLabel}"/>
                                <ItemsControl ItemsSource="{Binding MemberChoices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:MemberChoiceViewModel}">
                                            <CheckBox IsChecked="{Binding IsMember}" IsEnabled="{Binding IsEditable}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="9" Height="9" Fill="{Binding Expert.ColorBrush}"
                                                             VerticalAlignment="Center" Margin="2,0,6,0"/>
                                                    <TextBlock Text="{Binding Expert.Name}"/>
                                                    <TextBlock Text="  ★ coordinator" Foreground="{DynamicResource Accent}"
                                                               Visibility="{Binding Expert.IsCoordinator, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Text="  (added automatically)" Foreground="{DynamicResource TextMuted}"
                                                               Visibility="{Binding IsAutomatic, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No experts yet: add them in the Experts tab." >
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MemberChoices.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Text="{Binding CoordinatorInfo}" Style="{StaticResource HintText}" Margin="0,4,0,0"/>

                                <TextBlock Text="Initial prompt (optional)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding InitialPrompt, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MultiLineBox}"/>

                                <TextBlock Text="Additional council instructions (optional)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding ExtraInstructions, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MultiLineBox}"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                                           Text="Appended to the protocol generated for each member (members, coordinator, messaging rules, shared folder)."/>

                                <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorLine}"
                                           Visibility="{Binding Error, Converter={StaticResource NullToVis}}"/>

                                <WrapPanel Margin="0,20,0,0">
                                    <Button Content="Protocols and shared folder" Style="{StaticResource SmallToolButtonStyle}"
                                            Command="{Binding DataContext.OpenCouncilFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Generated protocols and the shared folder"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================================ EXPERTS ================================ -->
            <Grid Visibility="{Binding IsChecked, ElementName=ExpertsTab, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <DockPanel Margin="11,12,11,0">
                    <DockPanel DockPanel.Dock="Top" Margin="7,0,7,4">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton Content="Favorites only" Margin="0,0,8,0"
                                          IsChecked="{Binding FavoriteExpertsOnly}" Style="{StaticResource FilterToggleStyle}"/>
                            <Button Content="Refresh" Command="{Binding RefreshExpertsCommand}"
                                    Style="{StaticResource ToolButtonStyle}" Margin="0,0,8,0"
                                    ToolTip="Re-read CLAUDE.md, skills and expert.json from the folders (e.g. after a git pull)"/>
                            <Button Content="Import experts…" Command="{Binding ImportExpertsCommand}"
                                    Style="{StaticResource ToolButtonStyle}" Margin="0,0,8,0"
                                    ToolTip="Register experts already set up in a folder (e.g. a colleague's repo)"/>
                            <Button Content="＋  Add expert…" Command="{Binding AddExpertCommand}"
                                    Style="{StaticResource ToolButtonStyle}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Text="An expert is a folder with its CLAUDE.md and skills (.claude\skills\&lt;name&gt;\SKILL.md). Sessions start in the council's working folder and load CLAUDE.md and skills from the expert's folder."/>
                    </DockPanel>

                    <ListBox ItemsSource="{Binding ExpertsView}" SelectedItem="{Binding SelectedExpert}"
                             Style="{StaticResource CardListStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ExpertViewModel}">
                                <Grid>
                                <DockPanel Width="300">
                                    <Border DockPanel.Dock="Left" Width="5" CornerRadius="2.5" Margin="0,0,12,0"
                                            Background="{Binding ColorBrush}"/>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" MaxWidth="150"
                                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="  ★ coordinator" FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Accent}"
                                                       Visibility="{Binding IsCoordinator, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Folder}" FontSize="11" Margin="0,2,26,6"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}"
                                                   Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock Text="{Binding Settings}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorLine}"
                                                   Visibility="{Binding Error, Converter={StaticResource NullToVis}}"/>
                                    </StackPanel>
                                </DockPanel>
                                <ToggleButton IsChecked="{Binding IsFavorite}" Style="{StaticResource FavoriteToggleStyle}"
                                              HorizontalAlignment="Right" Margin="0,-6,-6,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Expert editor -->
                <Border Grid.Column="1" Style="{StaticResource EditorPanelStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding SelectedExpert}"
                                  Visibility="{Binding Converter={StaticResource NullToVis}}">
                        <StackPanel Margin="20,18">
                            <TextBlock Text="Expert" Style="{StaticResource EditorTitle}"/>

                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>

                            <CheckBox IsChecked="{Binding IsCoordinator}" Margin="0,14,0,0"
                                      Content="Council coordinator" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource HintText}" Margin="20,0,0,0"
                                       Text="There is only one (ticking it here clears it on the previous expert). It joins councils with two or more experts automatically and gets the initial prompt."/>

                            <TextBlock Text="Folder" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Folder, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource FieldBox}"
                                     Foreground="{DynamicResource TextSecondary}"/>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="Open" Style="{StaticResource SmallToolButtonStyle}"
                                        Command="{Binding DataContext.OpenExpertFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="Change…" Style="{StaticResource SmallToolButtonStyle}"
                                        Command="{Binding DataContext.ChangeExpertFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </WrapPanel>

                            <TextBlock Text="Description (shown to the other council members)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MultiLineBox}" Height="64"/>

                            <TextBlock Text="Color" Style="{StaticResource FieldLabel}"/>
                            <ItemsControl ItemsSource="{x:Static vm:MainViewModel.Palette}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SwatchButtonStyle}" Background="{Binding}"
                                                ToolTip="{Binding}"
                                                Command="{Binding DataContext.SetColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Border Width="30" Height="30" CornerRadius="6" Background="{Binding ColorBrush}" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" Width="110"
                                         Style="{StaticResource FieldBox}" ToolTip="#RRGGBB"/>
                            </StackPanel>

                            <TextBlock Text="Model (empty = Claude Code's default)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                                     ToolTip="Alias (opus, sonnet, …) or full model name"/>
                            <ItemsControl ItemsSource="{x:Static vm:MainViewModel.ModelOptions}" Margin="0,6,0,0"
                                          ItemTemplate="{StaticResource ModelChipTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <TextBlock Text="Effort (empty = Claude Code's default)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Effort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                            <ItemsControl ItemsSource="{x:Static vm:MainViewModel.EffortOptions}" Margin="0,6,0,0"
                                          ItemTemplate="{StaticResource EffortChipTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <TextBlock Text="CLAUDE.md and skills" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Edit CLAUDE.md" Style="{StaticResource SmallToolButtonStyle}"
                                        Command="{Binding DataContext.EditClaudeMdCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="Create CLAUDE.md" Style="{StaticResource SmallToolButtonStyle}"
                                        Command="{Binding DataContext.CreateClaudeMdCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="Open skills folder" Style="{StaticResource SmallToolButtonStyle}"
                                        Command="{Binding DataContext.OpenSkillsFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{Binding SkillsFolder}"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                                       Text="Skills live in the expert's folder, not in the user profile: one subfolder per skill with its SKILL.md, in .claude\skills\&lt;name&gt;\. That keeps the expert self-contained and versionable in git. After adding some, click Refresh."/>

                            <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorLine}"
                                       Visibility="{Binding Error, Converter={StaticResource NullToVis}}"/>

                            <TextBlock Style="{StaticResource HintText}" Margin="0,18,0,0"
                                       Text="The expert's settings are also saved to expert.json in its folder: together with CLAUDE.md and skills you can version them in git, and a colleague can import them with Import experts…."/>

                            <Button Content="Remove expert" Style="{StaticResource SmallToolButtonStyle}"
                                    HorizontalAlignment="Left" Margin="0,24,0,0"
                                    Command="{Binding DataContext.RemoveExpertCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="Removes the expert from the app; its folder is not deleted"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ================================ SETTINGS ================================ -->
            <ScrollViewer Visibility="{Binding IsChecked, ElementName=SettingsTab, Converter={StaticResource BoolToVis}}"
                          VerticalScrollBarVisibility="Auto" DataContext="{Binding Settings}">
                <StackPanel Margin="28,20" MaxWidth="780" HorizontalAlignment="Left">
                    <TextBlock Text="Claude Code" Style="{StaticResource EditorTitle}"/>
                    <TextBlock Text="{Binding ClaudeInfo}" TextWrapping="Wrap" Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource ErrorText}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ClaudeProblem}" Value="{x:Null}">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="Path of claude.exe (empty = detected automatically)" Style="{StaticResource FieldLabel}"/>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Content="Browse…" Command="{Binding BrowseClaudeCommand}" Style="{StaticResource SmallToolButtonStyle}"/>
                            <Button Content="Detect automatically" Command="{Binding AutoDetectClaudeCommand}" Style="{StaticResource SmallToolButtonStyle}"/>
                            <Button Content="Recheck" Command="{Binding RecheckClaudeCommand}" Style="{StaticResource SmallToolButtonStyle}" Margin="0"/>
                        </StackPanel>
                        <!-- Updated on focus loss, not per keystroke: every change re-runs the version check. -->
                        <TextBox Text="{Binding ClaudePath}" Style="{StaticResource FieldBox}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding ClaudeRequirement}" Style="{StaticResource HintText}" Margin="0,6,0,0"/>

                    <TextBlock Text="Session launch" Style="{StaticResource EditorTitle}" Margin="0,30,0,0"/>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                               Text="Every Claude session runs in PowerShell 7, in the council's working folder. Choose where to open it:"/>

                    <RadioButton GroupName="Host" IsChecked="{Binding UseWindowsTerminal}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Windows Terminal" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="One window per council, one tab per member with the expert's name and color."/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="Host" IsChecked="{Binding UsePowerShellWindow}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="PowerShell window" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource HintText}" Text="A separate window for each member."/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="Host" IsChecked="{Binding UseCustom}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Custom command" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="Another terminal (WezTerm, Alacritty, Tabby, …): set the program and the arguments to start it with."/>
                        </StackPanel>
                    </RadioButton>
                    <StackPanel Margin="26,4,0,0" IsEnabled="{Binding UseCustom}">
                        <TextBlock Text="Program" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CustomProgram, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                        <TextBlock Text="Arguments" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CustomArguments, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0">
                            <Run Text="Available placeholders:"/>
                            <Run Text="{Binding CustomPlaceholders, Mode=OneWay}" FontFamily="Consolas"/>
                            <LineBreak/>
                            <Run Text="The pwsh / pwshArgs pair starts the Claude session and must be there. Quote values that may contain spaces, e.g. --cwd &quot;{workdir}&quot;."/>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Text="PowerShell" Style="{StaticResource EditorTitle}" Margin="0,30,0,0"/>
                    <TextBlock Text="{Binding PowerShellInfo}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Path of pwsh.exe (empty = newest installed version)" Style="{StaticResource FieldLabel}"/>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Content="Browse…" Command="{Binding BrowsePowerShellCommand}" Style="{StaticResource SmallToolButtonStyle}"/>
                            <Button Content="Detect automatically" Command="{Binding AutoDetectPowerShellCommand}"
                                    Style="{StaticResource SmallToolButtonStyle}" Margin="0"/>
                        </StackPanel>
                        <TextBox Text="{Binding PowerShellPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                    </DockPanel>

                    <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorLine}" Margin="0,16,0,0"
                               Visibility="{Binding Error, Converter={StaticResource NullToVis}}"/>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,16,0,0"
                               Text="Settings are saved right away and apply to the next sessions started."/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
