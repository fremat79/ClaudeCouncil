<Window x:Class="ClaudeCouncilManager.Views.TerminateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stop sessions"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Segoe UI">

    <StackPanel Margin="24,20">
        <TextBlock x:Name="Heading" Style="{StaticResource EditorTitle}" TextWrapping="Wrap"/>

        <Border Margin="0,12,0,0" Padding="14,10" CornerRadius="8"
                Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
            <TextBlock x:Name="SessionList" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPrimary}"/>
        </Border>

        <TextBlock Style="{StaticResource HintText}" Margin="0,10,0,0"
                   Text="Work in progress is interrupted. The conversations stay saved: reopen them with Resume."/>

        <CheckBox x:Name="CloseTerminalBox" Margin="0,16,0,0" FontWeight="SemiBold"
                  Content="Also close the terminal windows/tabs"/>
        <TextBlock Style="{StaticResource HintText}" Margin="20,0,0,0"
                   Text="If unticked, a PowerShell prompt in the working folder takes Claude's place."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource ToolButtonStyle}" Margin="0,0,10,0"/>
            <Button Click="OnTerminate" IsDefault="True" Width="150" Height="36" FontSize="14"
                    Style="{StaticResource AccentButtonStyle}">
                <TextBlock Text="Stop"/>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
