<Window x:Class="ClaudeCouncilManager.Views.MarkdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="780" Width="1040" MinHeight="360" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/council.ico"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Segoe UI"
        PreviewKeyDown="OnPreviewKeyDown">

    <DockPanel>
        <!-- File and view mode -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource TopBarBackground}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="18,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <RadioButton x:Name="PreviewMode" Content="Preview" GroupName="Mode"
                                 Style="{StaticResource NavTabStyle}" Checked="OnModeChanged"/>
                    <RadioButton x:Name="EditMode" Content="Edit" GroupName="Mode"
                                 Style="{StaticResource NavTabStyle}" Checked="OnModeChanged"/>
                    <RadioButton x:Name="SplitMode" Content="Side by side" GroupName="Mode"
                                 Style="{StaticResource NavTabStyle}" Checked="OnModeChanged"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="Caption" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="FilePath" FontSize="11" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Commands and find -->
        <DockPanel DockPanel.Dock="Top" Margin="18,10,18,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="FindStatus" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"
                           Foreground="{DynamicResource TextMuted}"/>
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"
                           Margin="0,0,6,0" Foreground="{DynamicResource TextMuted}"/>
                <TextBox x:Name="FindBox" Width="220" Style="{StaticResource FieldBox}"
                         ToolTip="Find (Ctrl+F). Enter or F3 jumps to the next match."
                         KeyDown="OnFindKeyDown" TextChanged="OnFindTextChanged"/>
            </StackPanel>
            <WrapPanel VerticalAlignment="Center">
                <Button x:Name="SaveButton" Content="Save" Click="OnSave" Style="{StaticResource SmallToolButtonStyle}"
                        ToolTip="Save (Ctrl+S)"/>
                <Button Content="Open…" Click="OnOpenOther" Style="{StaticResource SmallToolButtonStyle}"
                        ToolTip="Open another Markdown file"/>
                <Button Content="Show in folder" Click="OnShowInFolder" Style="{StaticResource SmallToolButtonStyle}"/>
                <Button Content="Open externally" Click="OnOpenExternally" Style="{StaticResource SmallToolButtonStyle}"
                        ToolTip="Open with the app Windows associates with .md files"/>
            </WrapPanel>
        </DockPanel>

        <!-- The file changed on disk while there are unsaved edits -->
        <Border x:Name="ChangedBanner" DockPanel.Dock="Top" Visibility="Collapsed" Margin="18,0,18,8" Padding="14,8"
                CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Accent}"
                Background="{DynamicResource CardBackground}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button Content="Reload" Click="OnReloadFromDisk" Style="{StaticResource SmallToolButtonStyle}"
                            ToolTip="Discard your edits and show the file as it is on disk"/>
                    <Button Content="Keep my edits" Click="OnKeepEdits" Style="{StaticResource SmallToolButtonStyle}" Margin="0"
                            ToolTip="Saving will overwrite the version on disk"/>
                </StackPanel>
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"
                           Text="The file changed on disk (for example the coordinator added to it) while you have unsaved edits."/>
            </DockPanel>
        </Border>

        <Border Margin="18,0,18,18" CornerRadius="10" BorderThickness="1" Padding="1"
                BorderBrush="{DynamicResource CardBorder}" Background="{DynamicResource CardBackground}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="EditorColumn" Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition x:Name="PreviewColumn" Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="Editor" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                         HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="13" Padding="14,12"
                         BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}"
                         IsInactiveSelectionHighlightEnabled="True"
                         TextChanged="OnEditorTextChanged" GotKeyboardFocus="OnEditorFocused"/>
                <GridSplitter x:Name="Splitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext" Background="{DynamicResource Border}"/>
                <FlowDocumentScrollViewer x:Name="Preview" Grid.Column="2" IsToolBarVisible="False"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          IsInactiveSelectionHighlightEnabled="True"
                                          GotKeyboardFocus="OnPreviewFocused"/>
            </Grid>
        </Border>
    </DockPanel>
</Window>
