<Window x:Class="ClaudeCouncilManager.Views.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ClaudeCouncilManager.ViewModels"
        Title="Importa esperti"
        Height="620" Width="760" MinHeight="380" MinWidth="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Segoe UI">

    <DockPanel Margin="20,16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Importa esperti" Style="{StaticResource EditorTitle}"/>
            <TextBlock Text="{Binding Root}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Root}" Foreground="{DynamicResource TextMuted}"/>
            <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                       Text="Sono elencate la cartella scelta e le sue sottocartelle che contengono un CLAUDE.md o un expert.json. Le impostazioni (descrizione, modello, effort, colore, coordinatore) arrivano da expert.json; le cartelle restano dove sono e non vengono copiate."/>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="Tutti" Command="{Binding SelectAllCommand}" Style="{StaticResource SmallToolButtonStyle}"/>
                <Button Content="Nessuno" Command="{Binding SelectNoneCommand}" Style="{StaticResource SmallToolButtonStyle}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annulla" IsCancel="True" Style="{StaticResource ToolButtonStyle}" Margin="0,0,10,0"/>
                <Button Click="OnImport" IsDefault="True" IsEnabled="{Binding CanImport}" Width="190"
                        Style="{StaticResource AccentButtonStyle}" Height="36" FontSize="14">
                    <TextBlock Text="{Binding ImportButtonText}"/>
                </Button>
            </StackPanel>
        </DockPanel>

        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1" CornerRadius="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Candidates}" Margin="14,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ImportCandidateViewModel}">
                            <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsSelectable}"
                                      VerticalContentAlignment="Top" Margin="0,6">
                                <StackPanel Margin="4,-2,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Fill="{Binding ColorBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Description}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Folder}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Folder}" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="{Binding Note}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Accent}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Note}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
